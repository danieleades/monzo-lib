{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgeCrate",
    "customManagers:githubActionsVersions",
  ],

  "automerge": true,

  "packageRules": [
    // Crates in the public API: a breaking bump is breaking for our users too.
    {
      "matchPackageNames": ["serde", "serde_json"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
    },
    // As above, but Renovate classes breaking 0.x bumps as "minor".
    {
      "matchPackageNames": ["chrono", "reqwest"],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false,
    },
    // Nightlies publish daily; refresh the pinned toolchain monthly instead.
    {
      "matchPackageNames": ["rust"],
      "extends": ["schedule:monthly"],
    },
  ],
}
