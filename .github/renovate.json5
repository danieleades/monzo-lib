{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgeCrate",
    "customManagers:githubActionsVersions",
  ],

  "automerge": true,

  "packageRules": [
    // Major updates can affect the public API, so review them by hand.
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
    },
    // Lock file maintenance picks up patches weekly; avoid one PR per patch.
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "extends": ["schedule:monthly"],
    },
    // Keep formatting and linting reproducible while refreshing nightly monthly.
    {
      "matchDatasources": ["rust-version"],
      "matchPackageNames": ["rust"],
      "extends": ["schedule:monthly"],
    },
  ],
}
